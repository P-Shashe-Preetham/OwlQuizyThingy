{
  "name": "rahoot",
  "scripts": {
    "dev": "dotenv -e .env -- pnpm -r --parallel dev",
    "dev:web": "dotenv -e .env -- pnpm --filter web dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @rahoot/web build",
    "start": "pnpm -r --parallel run start",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "test": "pnpm -r run test",
    "lint": "pnpm -r --workspace-concurrency=1 run lint",
    "typecheck": "pnpm --filter @rahoot/web tsc --noEmit && pnpm --filter @rahoot/common tsc --noEmit && pnpm --filter functions tsc --noEmit",
    "test:e2e": "pnpm exec playwright test",
    "test:a11y": "pnpm exec playwright test --grep @a11y",
    "test:rules": "firebase emulators:exec --only firestore,database,storage \"pnpm --filter rules test\"",
    "test:integration": "pnpm test --filter functions",
    "security:secrets": "gitleaks detect --source . -v",
    "security:sast": "semgrep scan --config auto .",
    "security:deps": "pnpm audit",
    "firebase:emulators": "firebase emulators:start"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node-fetch": "^2.6.13",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv-cli": "^11.0.0",
    "firebase-tools": "15.33.0",
    "lefthook": "^2.1.17",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@12.10.1"
}
