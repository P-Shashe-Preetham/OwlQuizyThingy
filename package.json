{
  "name": "rahoot",
  "scripts": {
    "dev": "dotenv -e .env -- pnpm -r --parallel dev",
    "dev:web": "dotenv -e .env -- pnpm --filter web dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @rahoot/web build",
    "start": "pnpm -r --parallel run start",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "test": "pnpm -r run test",
    "lint": "pnpm -r --parallel run lint",
    "test:e2e": "pnpm exec playwright test",
    "test:a11y": "echo \"Running A11y tests\"",
    "test:rules": "echo \"Running Rules tests\"",
    "test:integration": "echo \"Running integration tests\"",
    "test:mutation": "echo \"Running mutation tests\"",
    "test:lighthouse": "echo \"Running lighthouse tests\"",
    "security:secrets": "echo \"Running secrets scan\"",
    "security:sast": "echo \"Running SAST scan\"",
    "security:deps": "echo \"Running deps scan\"",
    "firebase:emulators": "echo \"Starting emulators\"",
    "firebase:deploy:dry-run": "echo \"Dry run deploy\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@types/node-fetch": "^2.6.13",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv-cli": "^11.0.0",
    "lefthook": "^2.1.17",
    "playwright": "^1.63.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs"
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
