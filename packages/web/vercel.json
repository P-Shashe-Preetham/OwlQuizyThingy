{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @rahoot/web build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/ws/(.*)",
      "destination": "https://owlquizythingy.onrender.com/ws/$1"
    },
    {
      "source": "/ws",
      "destination": "https://owlquizythingy.onrender.com/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
