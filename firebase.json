{
  "hosting": {
    "public": "packages/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/ws/**",
        "run": {
          "serviceId": "rahoot-socket"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "rahoot-socket"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
